# Supabase project connection (client-side — the app talks to Supabase's REST
# API directly from the browser, protected by Row Level Security). These are
# not secret: the anon key is meant to be public and is scoped by RLS.
VITE_SUPABASE_URL=https://esfwaptssbqueayefvrj.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Set to "true" only for local QA to force the app onto in-memory demo data
# instead of the live Supabase project. Never set this in production.
VITE_STUB_DATA=false
